{
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm install -g pnpm && pnpm install --no-frozen-lockfile && pnpm --filter server exec prisma generate",
  "buildCommand": "next build",
  "regions": ["lhr1"],
  "crons": [
    { "path": "/api/cron/relist", "schedule": "0 4 * * *" },
    { "path": "/api/cron/cart", "schedule": "0 3 * * *" },
    { "path": "/api/cron/release-funds", "schedule": "0 2 * * *" },
    { "path": "/api/cron/feedback", "schedule": "0 5 * * *" },
    { "path": "/api/cron/refresh", "schedule": "0 6 * * *" }
  ]
}
