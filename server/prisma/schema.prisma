// Grabitt v2 — Prisma Schema
// Every monetary calculation uses server-side values only.
// Never trust client-sent fee or net amounts. (§10.2)

generator client {
  provider      = "prisma-client-js"
  // native = local dev; rhel = Vercel serverless (Amazon Linux 2 / RHEL)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Users ──────────────────────────────────────────────────────────────────

enum UserGrade {
  grabber
  dealer
  trader
  pro
}

// Paid recurring plans (Stripe Billing). Prices/intervals live in
// packages/design-tokens SUBSCRIPTION_PLANS — the source of truth.
enum SubPlan {
  business      // €29/mo, 21-day trial — storefront, badge, instant Dealer
  service_ad    // €29/mo — advertise a service (tradespeople)
  page_banner   // €39/mo — banner across Grabitt pages
  directory     // €99/yr — business directory listing
  agent_15      // €49/mo — property agent, 15 active listings
  agent_40      // €99/mo — property agent, 40 active listings
  business_founding_annual // €249/yr — founding-cohort annual business plan
  business_annual // €290/yr — standard annual business plan
}

enum SubStatus {
  trialing
  active
  past_due
  canceled
  paused
}

// ── Homepage CMS (section layout) ─────────────────────────────────────────────
// Admin-controlled homepage blocks: which sections show and in what order.
model HomeSection {
  id        String  @id @default(uuid())
  key       String  @unique
  label     String
  enabled   Boolean @default(true)
  sortOrder Int

  @@index([sortOrder])
}

// Parallax hero slider — a set of slides (image + heading + link), NOT banners.
model HeroSlide {
  id         String   @id @default(uuid())
  heading    String?
  subheading String?
  imageUrl   String
  linkUrl    String?
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([sortOrder])
}

// ── Community content ─────────────────────────────────────────────────────────
// Editorial posts (island tips, economy write-ups, how-to guides) surfaced on the
// homepage. Admin-managed; readers just view them.
// Help Centre article (Q + A), grouped by category. Admin-managed from the
// executive suite; read publicly by the /help page and the AI assistant.
model HelpArticle {
  id         String   @id @default(uuid())
  category   String                         // category id, e.g. "getting-started"
  question   String
  answer     String
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([active])
}

// A member's application for a special status (student / blue_light / charity).
// Reviewed by an admin; approval grants the status + its benefit on the User.
model StatusApplication {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  kind        String                          // 'student' | 'blue_light' | 'charity'
  status      String   @default("pending")    // pending | approved | rejected
  details     String?                         // institution / service / charity reg no
  evidenceUrl String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([userId])
}

// One earning event: an affiliate credited for a validated signup they referred.
// The reward can be cash (amountCents, paid out) or points (credited to the
// affiliate's balance immediately), decided by the config in force at the time.
model AffiliateReferral {
  id             String   @id @default(uuid())
  affiliateId    String
  affiliate      User     @relation("AffiliateEarner", fields: [affiliateId], references: [id])
  referredUserId String   @unique
  rewardKind     String   @default("cash")       // 'cash' | 'points'
  amountCents    Int      @default(0)            // cash owed (rewardKind = cash)
  points         Int      @default(0)            // points granted (rewardKind = points)
  tier           String                          // 'founding' | 'standard' at time of earning
  status         String   @default("earned")     // earned | paid (points are paid on grant)
  paidAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([affiliateId])
  @@index([status])
}

// Singleton affiliate-programme configuration. Each tier has a reward KIND
// (cash or points) and AMOUNT (cents when cash, points when points); admins can
// switch what's offered at any time. `campaigns` holds date-scoped overrides
// (e.g. "€1 cash per signup for these dates") that take precedence while active.
model AffiliateConfig {
  id                String   @id @default("default")
  foundingKind      String   @default("cash")
  foundingAmount    Int      @default(500)       // €5.00 in cents, or points
  standardKind      String   @default("cash")
  standardAmount    Int      @default(200)       // €2.00 in cents, or points
  campaigns         Json     @default("[]")      // [{ name, from, to, tier, kind, amount }]
  foundingCap       Int      @default(250)
  // Legacy columns (kept for back-compat; no longer used).
  foundingRateCents Int      @default(500)
  standardRateCents Int      @default(200)
  updatedAt         DateTime @updatedAt
}

// A purchased, timed sponsorship/advertising placement. Bought one-off through
// the basket (Stripe payment mode) for a chosen number of months; active between
// startsAt and endsAt. Recurring subscriptions are handled separately.
model SponsorshipGrant {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  addonId     String                       // BUSINESS_ADDONS id (homepage_sponsor, …)
  months      Int
  amountCents Int
  pageTarget  String?                       // category/page slug for Category Sponsor; null = site-wide
  startsAt    DateTime @default(now())
  endsAt      DateTime
  status      String   @default("active")  // active | expired | cancelled
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([addonId])
  @@index([status])
}

// Singleton admin-editable sponsorship pricing (per-add-on monthly base price +
// whether it's on sale). `data` is { addons: { [id]: { monthlyCents, active } } }.
model SponsorshipConfig {
  id        String   @id @default("default")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// Singleton financial planner model (assumptions, revenue streams, cost lines).
// Stored as one JSON blob so the shape can evolve without migrations; edited and
// exported from the executive suite.
model ForecastModel {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
}

// Singleton account-level configuration: personal grades, business tiers, and
// special statuses (student / blue light / charity). Defaults live in code;
// admins override here from the executive suite.
model AccountLevelsConfig {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
}

model CommunityPost {
  id         String   @id @default(uuid())
  title      String
  excerpt    String                       // short teaser shown on the strip
  body       String                       // full article (markdown-ish plain text)
  category   String   @default("Guide")   // e.g. Guide, Island Tips, Economy, Selling
  emoji      String   @default("📰")
  imageUrl   String?
  published  Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published])
  @@index([sortOrder])
}

// ── Compliance / GDPR ─────────────────────────────────────────────────────────
enum ConsentKind {
  gdpr                // GDPR data-processing acceptance
  withdrawal_waiver   // EU right-to-withdraw exemption disclaimer (digital marketplace)
}

// Immutable audit trail of consent acceptances (proof of when + who accepted).
model Consent {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  kind        ConsentKind
  version     String      @default("1")
  // Immutable snapshot of who accepted — survives later GDPR anonymisation,
  // so the waiver record stands if a user later disputes it.
  email       String
  displayName String
  acceptedAt  DateTime    @default(now())
  ipAddress   String?
  userAgent   String?

  @@index([userId])
  @@index([kind])
}

enum DeletionStatus {
  requested
  completed
}

// GDPR erasure requests — recorded even after the account PII is cleared.
model DeletionRequest {
  id          String         @id @default(uuid())
  userId      String         // kept as a reference; the User row is anonymised, not deleted
  email       String         // email at time of request (for the audit record)
  displayName String
  status      DeletionStatus @default(requested)
  requestedAt DateTime       @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([requestedAt])
}

// ── Business accounts ─────────────────────────────────────────────────────────

enum BusinessVerificationStatus {
  not_started
  pending      // documents submitted, awaiting review
  approved
  rejected
}

// Evidence that a business is a real, registered business. Reviewed by hand —
// this is what separates a Business account from someone who ticked a box, and
// it gates the storefront, multibuy and the 🏢 badge.
//
// Documents live in a private bucket; only the path is stored, and only the
// owner or an admin can fetch one through a signed URL.
model BusinessVerification {
  id                String                     @id @default(uuid())
  userId            String                     @unique
  user              User                       @relation(fields: [userId], references: [id])
  status            BusinessVerificationStatus @default(not_started)

  // Spain: a company files registration documents; an autónomo files the
  // Modelo 036/037 registration instead. One or the other is required.
  registrationDocPath String?                  // escritura / registro mercantil
  modelo036DocPath    String?                  // autónomo: Modelo 036 or 037
  // A recent utility bill or supplier invoice in the business name.
  proofOfAddressPath  String?

  legalName         String?
  taxId             String?                    // CIF / NIF
  website           String?
  socials           Json?                      // { instagram, facebook, tiktok, linkedin, x }

  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedById      String?
  rejectionReason   String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([status])
}

// A business seller's shop page. Separate from the listing feed — its own
// address, its own layout, its own policies.
model Storefront {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  slug            String   @unique          // /shop/<slug>

  template        String   @default("classic") // classic | grid | showcase | minimal
  tagline         String?
  about           String?
  bannerUrl       String?
  logoUrl         String?
  accentColour    String?

  // The seller's own shelf headings, e.g. ["Vintage", "Clearance"].
  categories      String[] @default([])
  // Listing ids the seller pins to the top of the shop.
  featuredIds     String[] @default([])

  shippingPolicy  String?
  returnsPolicy   String?
  paymentPolicy   String?

  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published])
}

model Subscription {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  plan                 SubPlan
  status               SubStatus
  stripeSubscriptionId String    @unique
  stripeCustomerId     String
  currentPeriodEnd     DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
}

enum Locale {
  en
  es
  de
  da
  sv
  nl
  fr
  pt
}

model User {
  id                 String    @id @default(uuid())
  supabaseId         String    @unique
  email              String    @unique
  displayName        String
  avatar             String?
  phone              String?   // contact number, shared with a buyer only after a completed collection sale
  collectionAddress  String?   // collection address, shared with a buyer only after a completed collection sale
  grade              UserGrade @default(grabber)
  salesCount         Int       @default(0)
  avgRating          Float?
  credits            Int       @default(50)
  // A redeemed reward can grant a temporary reduction of the item-sale fee:
  // subtract `feeReductionPct` percentage points from the seller's fee until
  // `feeReductionUntil`. Null/expired = no reduction.
  feeReductionPct    Decimal?  @db.Decimal(5, 2)
  feeReductionUntil  DateTime?
  // Granted special status (student | blue_light | charity), its ongoing
  // selling-fee discount in percentage points, and — for Founding cohort —
  // whether they hold the Founding Member badge.
  memberStatus       String?
  statusDiscountPct  Decimal?  @db.Decimal(5, 2)
  // Admin per-account fee override (absolute item-sale fee %, e.g. 3.00). When
  // set it replaces the grade fee as the base; discounts still apply on top.
  feeOverridePct     Decimal?  @db.Decimal(5, 2)
  foundingMember     Boolean   @default(false)
  // Affiliate programme — an affiliate earns cash per validated signup made via
  // their referral link. `affiliateTier` sets which rate applies.
  isAffiliate        Boolean   @default(false)
  affiliateTier      String?   // 'founding' | 'standard'
  isBusiness         Boolean   @default(false)
  businessVerified   Boolean   @default(false)
  businessTrialEnds  DateTime?
  businessName       String?
  businessBio        String?
  businessBanner     String?
  // Optional recurring add-ons the business has opted into (ids from
  // BUSINESS_ADDONS). Canonical source of truth; the Stripe subscription's line
  // items are reconciled to match this set.
  businessAddons     String[]  @default([])
  // Set once the business has completed the first-login business-details step.
  // Null = still needs to enter their details.
  businessOnboardedAt DateTime?

  // Property-agent profile — when set, an agent's contact details (WhatsApp,
  // email, agency) are shown on their property listings so buyers can reach them
  // directly. Separate from the phone above, which is escrow-gated.
  isPropertyAgent    Boolean   @default(false)
  agencyName         String?
  agentWhatsapp      String?
  agentEmail         String?
  // Active-property-listing allowance from the agent's monthly plan (0 = none).
  propertyListingAllowance Int  @default(0)

  // Tenant profile — a renter's details, shared with an agent when they enquire
  // about a rental so the agent can pre-qualify them.
  tenantBudget       Int?      // max monthly budget in €
  tenantMoveIn       String?   // free text, e.g. "ASAP" or "Sept 2026"
  tenantOccupants    Int?
  tenantEmployment   String?   // e.g. Employed, Self-employed, Student, Retired
  tenantHasPets      Boolean   @default(false)
  tenantSmoker       Boolean   @default(false)
  tenantAbout        String?   // short intro / references note

  // Compliance (GDPR consent + EU right-to-withdraw waiver + erasure)
  gdprAcceptedAt            DateTime?
  withdrawalWaiverAcceptedAt DateTime?
  deletedAt                 DateTime?  // GDPR erasure: PII cleared, access revoked, records kept
  stripeAccountId    String?
  stripeCustomerId   String?
  locale             Locale    @default(en)

  // Verification
  isVerified         Boolean   @default(false)
  emailVerified      Boolean   @default(false)
  phoneVerified      Boolean   @default(false)
  idVerified         Boolean   @default(false)
  addressVerified    Boolean   @default(false)
  // ID / address docs awaiting manual review: 'none' | 'pending'. Approval flips
  // idVerified/addressVerified via the exec member admin. The doc itself lives in
  // a private bucket; the path is served only to the owner/admin via signed URL.
  idDocStatus        String    @default("none")
  addressDocStatus   String    @default("none")
  idDocPath          String?
  addressDocPath     String?
  // Phone OTP (hashed code + expiry); cleared once verified.
  phoneOtpHash       String?
  phoneOtpExpiresAt  DateTime?

  // Referral: each user has a shareable code; referredBy links to whoever's code
  // they signed up with. referralRewarded guards the one-time "first listing"
  // bonus so both parties are credited exactly once.
  referralCode       String?   @unique
  referredById       String?
  referredBy         User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals          User[]    @relation("Referrals")
  referralRewarded   Boolean   @default(false)

  // Moderation
  strikeCount        Int       @default(0)
  suspendedAt        DateTime?
  suspendedUntil     DateTime?
  suspendedReason    String?

  // Snowbird mode — member marks themselves away
  snowbirdMode       Boolean   @default(false)
  snowbirdUntil      DateTime?
  // Marketing email: consent is the GDPR lawful basis, so campaigns may only go
  // to marketingConsent = true. The token powers one-click unsubscribe.
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  unsubscribeToken   String    @unique @default(uuid())

  // Attributes & preferences — personalisation, alerts, job matching and the
  // targeting behind marketing e-shots. Captured at onboarding, editable in the
  // account.
  interests          String[]  @default([])   // department names
  subInterests       String[]  @default([])   // "Department:Sub-category"
  hobbies            String[]  @default([])
  skills             String[]  @default([])

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  listings           Listing[]
  cartItems          CartItem[]
  buyerTransactions  Transaction[]      @relation("Buyer")
  sellerTransactions Transaction[]      @relation("Seller")
  sentMessages       Message[]
  threads            ThreadParticipant[]
  notifications      Notification[]
  creditEvents       CreditEvent[]
  statusApplications StatusApplication[]
  affiliateReferrals AffiliateReferral[] @relation("AffiliateEarner")
  sponsorshipGrants  SponsorshipGrant[]
  wishlistItems      WishlistItem[]
  wishItems          WishItem[]
  savedSearches      SavedSearch[]
  reviews            Review[]           @relation("ReviewAuthor")
  receivedReviews    Review[]           @relation("ReviewSubject")
  disputes           Dispute[]          @relation("DisputeRaiser")
  crmContacts        CrmContact[]       @relation("CrmAssigned")
  handyListings      HandyListing[]
  following          Following[]        @relation("Follower")
  followers          Following[]        @relation("Following")
  pushTokens         PushToken[]
  reportsFiled       Report[]           @relation("Reporter")
  reportsAgainst     Report[]           @relation("ReportedUser")
  jobApplications    JobApplication[]
  strikes            UserStrike[]
  execAuditLogs      ExecAuditLog[]     @relation("ExecTarget")
  subscriptions      Subscription[]
  consents           Consent[]
  seekerProfile      SeekerProfile?
  candidateUnlocks   CandidateUnlock[]  @relation("EmployerUnlocks")
  unlockedBy         CandidateUnlock[]  @relation("SeekerUnlocked")
  candidateViews     CandidateView[]    @relation("EmployerViews")
  businessVerification BusinessVerification?
  storefront         Storefront?
  viewedBy           CandidateView[]    @relation("SeekerViewed")
  eshotRecipients    EshotRecipient[]

  @@index([grade])
  @@index([email])
}

// A job-seeker's "available for work" profile. Employers search these anonymously
// via Find Staff and spend credits to unlock the person's contact details.
model SeekerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  headline         String?
  // sector kept for existing rows; sectors is the multi-select that replaced it,
  // so a candidate can offer themselves across more than one line of work.
  sector           String?
  sectors          String[] @default([])
  roles            String[] @default([])
  experienceMonths Int      @default(0)
  languages        String[] @default([])
  // [{ language, level }] — level being Basic / Conversational / Fluent / Native.
  languageLevels   Json?
  hours            String[] @default([])
  availability     String?
  rightToWork      String?
  location         String?  // broad area: Las Palmas / South GC / North GC / Remote
  town             String?  // specific town
  areaDetail       String?  // neighbourhood or district within that town
  active           Boolean  @default(true)
  // ── CV content — the candidate's real CV, entered structured and rendered to
  // a formatted PDF on apply. Repeatable sections are JSON arrays:
  //   workExperience: [{ title, employer, location, start, end, current, bullets[] }]
  //   education:      [{ qualification, institution, start, end, status }]
  summary          String?
  skills           String[] @default([])
  keyStrengths     String[] @default([])
  certifications   String[] @default([])
  workExperience   Json?
  education        Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active])
  @@index([sector])
}

// Records that an employer has paid credits to reveal a seeker — so re-viewing
// an already-unlocked candidate is free (idempotent unlock).
// A candidate profile an employer has opened. Charged once per candidate — the
// first view costs a credit, revisiting the same profile is free, so an employer
// isn't billed twice for changing their mind. Contact details are a separate,
// dearer step (CandidateUnlock).
model CandidateView {
  id         String   @id @default(uuid())
  employerId String
  employer   User     @relation("EmployerViews", fields: [employerId], references: [id])
  seekerId   String
  seeker     User     @relation("SeekerViewed", fields: [seekerId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([employerId, seekerId])
  @@index([employerId])
}

model CandidateUnlock {
  id         String   @id @default(uuid())
  employerId String
  employer   User     @relation("EmployerUnlocks", fields: [employerId], references: [id])
  seekerId   String
  seeker     User     @relation("SeekerUnlocked", fields: [seekerId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([employerId, seekerId])
  @@index([employerId])
}

model ExecUser {
  id           String         @id @default(uuid())
  email        String         @unique
  role         ExecRole
  createdAt    DateTime       @default(now())

  auditLogs    ExecAuditLog[]
  tasks        ExecTask[]
}

// Internal exec to-do / calendar item. One model serves both views: the To-Do
// board groups by `tier`, the Calendar places items by `dueDate`. Scoped to the
// exec who created it so each admin has their own list.
model ExecTask {
  id         String    @id @default(uuid())
  execUserId String
  execUser   ExecUser  @relation(fields: [execUserId], references: [id])
  text       String
  tier       String?   // 'urgent' | 'soon' | 'someday' (To-Do)
  dueDate    DateTime? @db.Date // (Calendar)
  color      String?   // dot colour on the calendar
  done       Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([execUserId])
}

enum ExecRole {
  super_admin
  admin
  support
}

// ── Listings ────────────────────────────────────────────────────────────────

enum Department {
  home_garden
  jobs
  fashion
  sport
  gaming
  electronics
  gift_ideas
  kids_baby
  property
  health_fitness
  food_store
  retro_vintage
  grab_it_now
  handy_help
  pet_shop
  motors
  services
  collectables
  hobbies_crafts
  other
}

enum ListingCondition {
  new
  like_new
  very_good
  good
  fair
  spares
}

enum ListingStatus {
  draft
  active
  grab_it_now
  sold
  expired
  removed
}

model Listing {
  id               String           @id @default(uuid())
  sellerId         String
  seller           User             @relation(fields: [sellerId], references: [id])
  title            String
  description      String
  price            Decimal          @db.Decimal(10, 2)
  department       Department
  condition        ListingCondition
  // Item facts shown in the listing's Details panel (all optional — blank ones
  // render as "—", exactly as the template does).
  brand            String?
  colour           String?
  size             String?
  status           ListingStatus    @default(draft)
  images           String[]
  tags             String[]         @default([])  // auto-generated from title/description for search + discovery
  stock            Int              @default(1)    // units available; sold when it reaches 0 (multi-buy)
  location         String
  lat              Float?
  lng              Float?
  isFeatured       Boolean          @default(false)
  featuredUntil    DateTime?
  grabItNowUntil   DateTime?
  grabItNowWindow  Int?
  grabItNowPrice   Decimal?         @db.Decimal(10, 2)
  deliveryFee      Decimal          @default(0) @db.Decimal(10, 2)
  deliveryMethod   DeliveryMethod?  // null = delivery not offered (collection only)
  autoAcceptMin    Decimal?         @db.Decimal(10, 2)  // offers >= this are auto-accepted (seller-only, never shown to buyers)
  // Multibuy: [{ qty, discountPct }] — buy N, save X%. Business sellers only.
  multibuyTiers    Json?
  // Category-specific attributes, e.g. { Type, Style, Material } for fashion or
  // { Type, Storage } for electronics. Values are chosen from fixed lists so
  // they stay searchable. See lib/listingAttributes.
  attributes       Json?
  viewCount        Int              @default(0)
  relistCount      Int              @default(0)  // standard listings auto-relist free 3× every 21 days
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  transactions     Transaction[]
  jobListing       JobListing?
  propertyListing  PropertyListing?
  handyListing     HandyListing?
  wishlistItems    WishlistItem[]
  cartItems        CartItem[]
  reports          Report[]
  offers           Offer[]

  @@index([department])
  @@index([status])
  @@index([sellerId])
  @@index([isFeatured])
  @@index([createdAt(sort: Desc)])
  @@index([location])
}

// ── Transactions ─────────────────────────────────────────────────────────────

enum TransactionStatus {
  pending_payment
  held
  confirmed_handover
  completed
  released
  disputed
  refunded
  cancelled
}

enum FulfilmentType {
  collection   // buyer collects in person — released via QR handover scan
  courier      // shipped by tracked courier — released on first waypoint scan (in transit)
  delivery     // seller delivers in person (charged) — released via QR handover scan
}

// How a seller fulfils delivery when they offer it on a listing
enum DeliveryMethod {
  courier      // tracked shipping
  in_person    // seller drops off, confirmed by QR at the door
}

// Who a purchase is made as. A business account can buy for the business (for
// its own invoicing/VAT records) or personally — selling is always as the
// business, but buying is a per-purchase choice.
enum BuyerType {
  individual
  business
}

model Transaction {
  id                    String            @id @default(uuid())
  listingId             String
  listing               Listing           @relation(fields: [listingId], references: [id])
  buyerId               String
  buyer                 User              @relation("Buyer", fields: [buyerId], references: [id])
  sellerId              String
  seller                User              @relation("Seller", fields: [sellerId], references: [id])
  amount                Decimal           @db.Decimal(10, 2)
  platformFee           Decimal           @db.Decimal(10, 2)
  sellerNet             Decimal           @db.Decimal(10, 2)
  status                TransactionStatus @default(pending_payment)
  quantity              Int               @default(1)
  // Captured at checkout; business buyers choose per purchase. buyerBusinessName
  // is snapshotted so a later rename doesn't rewrite historical receipts.
  buyerType             BuyerType         @default(individual)
  buyerBusinessName     String?
  fulfilmentType        FulfilmentType    @default(collection)
  stripePaymentIntentId String?
  stripeTransferId      String?
  handoverQrToken       String?           // signed token for QR handover confirmation
  handoverConfirmedAt   DateTime?
  trackingCarrier       String?           // courier fulfilment: carrier name/slug
  trackingNumber        String?           // courier fulfilment: tracking number (tracked service required)
  firstScanAt           DateTime?         // legacy: kept for historical orders
  shippedAt             DateTime?         // courier: dispatched / first carrier scan
  deliveredAt           DateTime?         // courier: delivery confirmed → starts both timers below
  disputeWindowEndsAt   DateTime?         // deliveredAt + 24h; after this the item is deemed accepted
  fundsReleasedAt       DateTime?
  // Collection: handoverConfirmedAt + 14 days. Courier: deliveredAt + 48 hours.
  autoReleaseAt         DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  dispute               Dispute?
  reviews               Review[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([autoReleaseAt])
  @@index([listingId])
}

// ── Messaging ────────────────────────────────────────────────────────────────

enum MessageChannel {
  in_app
  sms
  whatsapp
}

model Thread {
  id            String             @id @default(uuid())
  listingId     String
  lastMessageAt DateTime?
  createdAt     DateTime           @default(now())

  participants  ThreadParticipant[]
  messages      Message[]

  @@index([listingId])
  @@index([lastMessageAt(sort: Desc)])
}

model ThreadParticipant {
  threadId String
  userId   String
  thread   Thread @relation(fields: [threadId], references: [id])
  user     User   @relation(fields: [userId], references: [id])

  @@id([threadId, userId])
}

model Message {
  id            String         @id @default(uuid())
  threadId      String
  thread        Thread         @relation(fields: [threadId], references: [id])
  senderId      String
  sender        User           @relation(fields: [senderId], references: [id])
  body          String
  channel       MessageChannel @default(in_app)
  blocked       Boolean        @default(false)
  blockedReason String?        // populated when contact-info regex fires (§10.2)
  readAt        DateTime?
  createdAt     DateTime       @default(now())

  @@index([threadId])
  @@index([senderId])
  @@index([createdAt])
}

// ── Notifications ─────────────────────────────────────────────────────────────

enum NotificationKind {
  new_message
  offer_received
  offer_accepted
  offer_declined
  offer_countered
  payment_held
  handover_confirmed
  funds_released
  new_review
  listing_expiring
  grade_upgrade
  grade_downgrade
  credits_received
  dispute_opened
  dispute_resolved
  wish_matched
  price_drop
  system
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  kind      NotificationKind
  title     String
  body      String
  actionUrl String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt(sort: Desc)])
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
