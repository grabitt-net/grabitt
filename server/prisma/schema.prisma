  @@index([userId])
}

// ── Following ────────────────────────────────────────────────────────────────

model Following {
  followerId  String
  followingId String
  follower    User     @relation("Follower",  fields: [followerId],  references: [id])
  following   User     @relation("Following", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ── Reports ───────────────────────────────────────────────────────────────────

enum ReportReason {
