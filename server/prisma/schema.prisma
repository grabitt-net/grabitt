}

// ── Offers ──────────────────────────────────────────────────────────────────

enum OfferStatus {
  pending
  accepted
  declined
  countered
  expired
  withdrawn
}

model Offer {
  id        String      @id @default(uuid())
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id])
  buyerId   String
  amount    Decimal     @db.Decimal(10, 2)
  message   String?
  status    OfferStatus @default(pending)
  counterAmount Decimal? @db.Decimal(10, 2)  // seller's (auto) counter price
  counterTier   Int      @default(0)         // auto counter ladder: 0=none, 1/2/3 (3=final=min)
  expiresAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([listingId])
  @@index([buyerId])
  @@index([status])
}

// Server-side basket. Items expire 12h after being added; warnings fire at 6h/10h.
model CartItem {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId    String
  listing      Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  qty          Int       @default(1)
  warn6SentAt  DateTime?
  warn10SentAt DateTime?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime

  @@unique([userId, listingId])
  @@index([userId])
  @@index([expiresAt])
}

// ── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id                  String      @id @default(uuid())
  transactionId       String
  transaction         Transaction @relation(fields: [transactionId], references: [id])
  authorId            String
  author              User        @relation("ReviewAuthor", fields: [authorId], references: [id])
  subjectId           String
  subject             User        @relation("ReviewSubject", fields: [subjectId], references: [id])
  rating              Int         // overall 1–5
  accuracyRating      Int?        // item as described 1–5
  communicationRating Int?        // seller responsiveness 1–5
  speedRating         Int?        // handover speed 1–5
  comment             String?
  createdAt           DateTime    @default(now())

  @@unique([transactionId, authorId])
  @@index([subjectId])
}

// ── Disputes ─────────────────────────────────────────────────────────────────

enum DisputeStatus {
  open
  under_review
  resolved_buyer
  resolved_seller
  escalated
}

model Dispute {
  id            String        @id @default(uuid())
  transactionId String        @unique
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  raisedById    String
  raisedBy      User          @relation("DisputeRaiser", fields: [raisedById], references: [id])
  reason        String
  evidence      String[]
  status        DisputeStatus @default(open)
  resolution    String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
}

// ── Credits ──────────────────────────────────────────────────────────────────

enum CreditEventKind {
  registration_bonus
  share_reward
  referral
  purchase
  featured_listing
  grab_it_now
  refund
  admin_adjustment
  extra_listing
  reward_earned
  reward_redeemed
}

// Ways to earn rewards (credits), shown in the account rewards dashboard and
// managed from the executive suite. `amount` is the credits granted.
model RewardRule {
  id          String   @id @default(uuid())
  code        String   @unique               // stable key, e.g. "invite_friend"
  icon        String   @default("🎁")
  title       String
  subtitle    String
  amount      Int                             // credits earned
  actionLabel String?                         // e.g. "Invite", "Share"
  actionKey   String?                         // client hint for the CTA (panel/route)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

// What rewards can be redeemed for. kind = 'listing_upgrade' | 'fee_reduction'.
// `config` holds the specifics (fee_reduction: { pct, days }; listing_upgrade:
// { upgrade: 'featured' | 'grab_it_now' | 'bump', weeks, hours }).
model RewardOption {
  id          String   @id @default(uuid())
  kind        String
  title       String
  description String
  costCredits Int
  config      Json?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model CreditEvent {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  kind      CreditEventKind
  delta     Int
  balance   Int
  note      String?
  createdAt DateTime        @default(now())

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

// ── Wishlist (saved listings) & Wish Items (wanted alerts) ─────────────────

model WishlistItem {
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, listingId])
  @@index([userId])
}

// WishItem = "I'm looking for X" — triggers wish_matched notification
model WishItem {
