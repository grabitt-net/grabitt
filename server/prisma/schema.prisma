// ── Banners & E-shots (Exec only) ────────────────────────────────────────────

enum BannerPosition {
  home_top
  home_mid
  category
  checkout
  jobs
  sponsor_top
  sponsor_footer
  messages
  notifications
}

model Banner {
  id        String         @id @default(uuid())
  title     String
  imageUrl  String
  linkUrl   String?
  active    Boolean        @default(false)
  approved     Boolean      @default(false) // admin must approve before a banner shows
  position  BannerPosition
  pageTarget   String?                     // category/page slug; null = every page for the position
  grantId      String?      @unique        // the SponsorshipGrant that paid for a self-serve banner
  startsAt  DateTime?
  endsAt    DateTime?
  clickCount   Int         @default(0)
  impressions  Int         @default(0)
  createdAt DateTime       @default(now())

  @@index([active])
  @@index([position])
  @@index([pageTarget])
}

enum EshotSegment {
  all
  grabber
  dealer
  trader
  pro
  business
  inactive_30
  inactive_60
  new_members
}

model Eshot {
  id          String       @id @default(uuid())
  subject     String
  bodyHtml    String
  preheader   String?      // inbox preview line
  fromName    String?      // overrides the default sender name
  segment     EshotSegment
  status      String       @default("draft") // draft | sending | sent | failed
  scheduledAt DateTime?
  sentAt      DateTime?
  // Rolled up from EshotRecipient by the Resend webhook.
  recipientCount Int       @default(0)
  deliveredCount Int       @default(0)
  bounceCount    Int       @default(0)
  complaintCount Int       @default(0)
  openCount   Int          @default(0)
  clickCount  Int          @default(0)
  createdAt   DateTime     @default(now())

  recipients  EshotRecipient[]

  @@index([sentAt])
}

// One row per person per campaign — the unit of delivery and engagement.
// resendId links a Resend email back to us when its webhook events arrive.
model EshotRecipient {
  id         String    @id @default(uuid())
  eshotId    String
  eshot      Eshot     @relation(fields: [eshotId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  email      String
  resendId   String?   @unique
  status     String    @default("queued") // queued | sent | delivered | bounced | complained | failed
  openCount  Int       @default(0)
  clickCount Int       @default(0)
  openedAt   DateTime?
  clickedAt  DateTime?
  bouncedAt  DateTime?
  error      String?
  createdAt  DateTime  @default(now())

  @@unique([eshotId, email])
  @@index([eshotId])
  @@index([userId])
}

// ── Affiliate / Referral ──────────────────────────────────────────────────────

model AffiliateLink {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  targetUrl   String
  clicks      Int       @default(0)
  conversions Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  referrals   Referral[]

  @@index([slug])
}

model Referral {
  id              String        @id @default(uuid())
  affiliateLinkId String
  affiliateLink   AffiliateLink @relation(fields: [affiliateLinkId], references: [id])
  referredEmail   String?
  registeredAt    DateTime?
  creditAwarded   Boolean       @default(false)
  createdAt       DateTime      @default(now())

  @@index([affiliateLinkId])
}
