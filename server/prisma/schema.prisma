  detail       Json?
  createdAt    DateTime  @default(now())

  @@index([execUserId])
  @@index([targetUserId])
  @@index([createdAt(sort: Desc)])
}

// ── Jobs ─────────────────────────────────────────────────────────────────────

enum JobType {
  full_time
  part_time
  contract
  temporary
  volunteer
}

// The prototype's candidate pipeline. applied/viewed/shortlisted/rejected/hired
// are the original five, kept so historical rows stay valid; everything new uses
// the seven below. Identity is released to the employer at `invited` — the point
// they ask to meet the candidate.
enum ApplicationStatus {
  applied
  viewed
  shortlisted
  rejected
  hired
  invited          // Invited to interview
  arranged         // Interview arranged
  offer            // Job offer made
  accepted         // Offer accepted
  rejected_pre     // Rejected without interview
  rejected_post    // Rejected after interview
}

model JobListing {
  id           String    @id @default(uuid())
  listingId    String    @unique
  listing      Listing   @relation(fields: [listingId], references: [id])
  employerId   String
  jobTitle     String
  // The employer's real name. Withheld from the public advert — browsers see
  // establishmentType instead, and the name is released to a candidate only once
  // they're invited to interview.
  company      String
  establishmentType String?  // e.g. "Beach bar", "4-star hotel", "Family restaurant"
  type         JobType
  salaryMin    Decimal?  @db.Decimal(10, 2)
  salaryMax    Decimal?  @db.Decimal(10, 2)
  salaryPeriod String?   // 'month' | 'year' | 'hour' — how the salary is quoted
  remote       Boolean   @default(false)
  skills       String[]
  applyUrl     String?
  expiresAt    DateTime?
  // Extended job-post details (Post a Job form)
  sector       String?   // job category e.g. Hostelería, Retail, Construction
  address      String?   // full address (also drives the listing map)
  hours        String?   // hours of operation e.g. "Mon–Fri 9:00–17:00"
  startDate    DateTime? // expected start date
  payments     Int?      // salary payments per year (e.g. 12 or 14)
  overtime     Boolean   @default(false)
  tips         Boolean   @default(false)
  // Employer-defined screening questions candidates answer on Apply.
  // Shape: [{ id, label, type: 'short'|'long'|'choice'|'boolean'|'number', required, options? }]
  applicationQuestions Json?
  createdAt    DateTime  @default(now())

  applications JobApplication[]
}

model JobApplication {
  id           String            @id @default(uuid())
  jobListingId String
  jobListing   JobListing        @relation(fields: [jobListingId], references: [id])
  applicantId  String
  applicant    User              @relation(fields: [applicantId], references: [id])
  coverNote    String?
  cvUrl        String?
  employerNote String?           // e.g. a required reason when an employer rejects
  // Structured recruitment data collected at apply time (owned platform data,
  // also shown to the employer). Prefilled from the applicant's SeekerProfile.
  fullName         String?
  email            String?
  phone            String?
  location         String?
  rightToWork      String?
  languages        String[]          @default([])
  experienceMonths Int?
  currentRole      String?
  expectedSalary   Int?
  availability     String?
  linkedinUrl      String?
  answers          Json?
  // Suitability is computed server-side at apply time and shown ONLY to the
  // employer. The candidate never sees it — a score shown to an applicant
  // invites challenge over how it was derived.
  suitabilityScore Int?
  suitabilityNotes Json?             // answers to the employer's screening questions
  dataConsent      Boolean           @default(false)
  // Full CV data captured at apply time — the recruiter sees what was submitted,
  // never a version the candidate edited afterwards. Rendered anonymised until
  // the application is shortlisted/hired or the candidate is unlocked, then full.
  cvSnapshot       Json?
  status       ApplicationStatus @default(applied)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([jobListingId, applicantId])
  @@index([jobListingId])
  @@index([applicantId])
}

// ── Property ─────────────────────────────────────────────────────────────────

enum PropertyType {
  sale
  rent
  holiday
  commercial
  land
  new_build
}

model PropertyListing {
  id           String       @id @default(uuid())
  listingId    String       @unique
  listing      Listing      @relation(fields: [listingId], references: [id])
  type         PropertyType
  bedrooms     Int?
  bathrooms    Int?
  m2           Decimal?     @db.Decimal(8, 2)
  community    String?
  floor        Int?
  hasPool      Boolean      @default(false)
  hasGarage    Boolean      @default(false)
  energyRating String?
  lat          Float?
  lng          Float?

  // Rental terms + tourist licence (Canary Islands VV licence for holiday lets).
  rentalTerm   String?      // short_term | long_term | holiday (rentals only)
  touristLicence String?    // holiday-let / vivienda vacacional licence number

  // Extended portal details (Idealista / thehubproperty style).
  plotM2       Decimal?     @db.Decimal(8, 2)
  terraceM2    Int?
  furnished    String?      // furnished | part_furnished | unfurnished
  orientation  String?      // e.g. South, South-West
  yearBuilt    Int?
  communityFees Int?        // €/month
  condition    String?      // new | good | needs_reform
  views        String?      // e.g. Sea, Mountain, Pool

  // Full agent-listing detail (thehubproperty-style form).
  reference    String?      // agent's own property reference
  address      String?      // full street address (from autocomplete)
  city         String?      // town/city (from autocomplete)
  coveredM2    Decimal?     @db.Decimal(8, 2)  // built/covered area
  landM2       Decimal?     @db.Decimal(10, 2) // plot/land area
  distShops    Int?         // metres to local shops
  distSchools  Int?         // metres to local schools
  distBeach    Int?         // metres to nearest beach
  distTown     Int?         // metres to nearest town
  // Features & amenities, e.g. ["garden","terrace","pool","parking","wifi",…]
  features     String[]

  createdAt    DateTime     @default(now())
}

// ── Handy Help ────────────────────────────────────────────────────────────────

enum HandyCategory {
  plumbing
  electrical
  cleaning
  painting
  gardening
  moving
  assembly
  it_support
  tutoring
  beauty
  beauty_nails
  pet_care
  childcare
  other
}

model HandyListing {
  id                String        @id @default(uuid())
  listingId         String        @unique
  listing           Listing       @relation(fields: [listingId], references: [id])
  providerId        String
  provider          User          @relation(fields: [providerId], references: [id])
  category          HandyCategory
  pricePerHour      Decimal?      @db.Decimal(8, 2)
  priceFixed        Decimal?      @db.Decimal(8, 2)
  availableDays     Int[]         // 0=Sun..6=Sat
  responseTimeHours Int?
  insured           Boolean       @default(false)
  createdAt         DateTime      @default(now())

  @@index([category])
  @@index([providerId])
}

// ── CRM (Exec only) ──────────────────────────────────────────────────────────

enum PipelineStage {
  lead
  qualified
  pitch
  proposal
  close
  won
  nurture
}

model CrmContact {
  id         String        @id @default(uuid())
  name       String
  email      String?
  phone      String?
  company    String?
  stage      PipelineStage @default(lead)
  value      Decimal       @default(0) @db.Decimal(10, 2)
  assignedTo String?
  assignee   User?         @relation("CrmAssigned", fields: [assignedTo], references: [id])
  notes      String?
  tags       String[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([stage])
  @@index([assignedTo])
